          "name": "健康检查",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('状态码 200', () => pm.response.to.have.status(200));",
                  "pm.test('服务在线', () => pm.expect(pm.response.json().data.status).to.eql('up'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          }
        }
      ]
    },
